    "Assign a single key or a combination. Pause shortcuts in the menu to type the assigned character.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign a single key or a combination. Pause shortcuts in the menu to type the assigned character."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно назначить одну клавишу или сочетание. Чтобы печатать назначенный символ, приостановите клавиши в меню."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna una tecla o una combinación. Para escribir ese carácter, pausa los atajos desde el menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une touche ou une combinaison. Pour saisir ce caractère, suspendez les raccourcis dans le menu."
          }
        }
      }
    },
