    "Recording time includes pauses. Deleting history does not change statistics. Retry and Copy never increment counters.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording time includes pauses. Deleting history does not change statistics. Retry and Copy never increment counters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время записи включает паузы. Удаление истории не меняет статистику. Повторная обработка и копирование не увеличивают счётчики."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de grabación incluye las pausas. Borrar el historial no cambia las estadísticas. Reintentar o copiar no aumenta los contadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée d’enregistrement inclut les pauses. Supprimer l’historique ne modifie pas les statistiques. Réessayer ou copier n’augmente pas les compteurs."
          }
        }
      }
    },
