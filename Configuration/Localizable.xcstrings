{
  "sourceLanguage": "en",
  "strings": {
    " and enable Veylume. If it is missing, add it with the “+” button. Return to Veylume afterwards to recheck access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and enable Veylume. If it is missing, add it with the “+” button. Return to Veylume afterwards to recheck access."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " и включите Veylume. Если приложения нет в списке, добавьте его кнопкой «+». После изменения вернитесь в Veylume: статус будет проверен заново."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " y activa Veylume. Si no aparece, añádelo con «+». Después vuelve a Veylume para comprobar los permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " et activez Veylume. S’il n’apparaît pas, ajoutez-le avec « + ». Revenez ensuite dans Veylume pour vérifier les accès."
          }
        }
      }
    },
    " · case sensitive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · case sensitive"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": " · с учётом регистра"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " · distingue mayúsculas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " · respecter la casse"
          }
        }
      }
    },
    "14 languages · no Russian · explicit language": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 languages · no Russian · explicit language"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14 языков · без русского · язык задаётся явно"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14 idiomas · sin ruso · selección manual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 langues · russe non pris en charge · choix manuel"
          }
        }
      }
    },
    "A little glass, gentle cues, and just what you need.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little glass, gentle cues, and just what you need."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного стекла, тихие сигналы и ничего лишнего."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un diseño ligero, sonidos discretos y lo esencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu de transparence, des sons discrets et l’essentiel."
          }
        }
      }
    },
    "A model is being prepared. Wait for it to finish or pause its installation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model is being prepared. Wait for it to finish or pause its installation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель подготавливается. Дождитесь завершения или приостановите её загрузку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está preparando un modelo. Espera a que termine o pausa la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle est en cours de préparation. Patientez ou mettez son installation en pause."
          }
        }
      }
    },
    "A signed update feed is not configured for this local build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A signed update feed is not configured for this local build."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лента подписанных обновлений ещё не настроена для этой локальной сборки."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión local aún no tiene un canal de actualizaciones firmadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version locale ne dispose pas encore d’un canal de mises à jour signées."
          }
        }
      }
    },
    "Access changed. Recording stopped; check permissions again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access changed. Recording stopped; check permissions again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ изменился. Запись остановлена; повторно проверьте разрешения."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos han cambiado. Se ha detenido la grabación. Revisa el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations ont changé. L’enregistrement a été arrêté. Vérifiez les accès."
          }
        }
      }
    },
    "Access is ready. Return to your app and start dictating.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is ready. Return to your app and start dictating."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступы готовы. Можно вернуться в своё приложение и начать диктовку."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo. Vuelve a tu aplicación y empieza a dictar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt. Revenez dans votre application et commencez à dicter."
          }
        }
      }
    },
