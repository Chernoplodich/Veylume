    "Once a model is installed, dictation works offline. Network access is used for model downloads and update checks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once a model is installed, dictation works offline. Network access is used for model downloads and update checks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После установки модели диктовка работает без интернета. Сеть нужна для загрузки моделей и проверки обновлений."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras instalar un modelo, puedes dictar sin conexión. Internet solo se usa para descargar modelos y buscar actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois un modèle installé, la dictée fonctionne hors ligne. Internet sert au téléchargement des modèles et à la recherche de mises à jour."
          }
        }
      }
    },
