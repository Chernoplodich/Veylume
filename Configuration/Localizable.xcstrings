          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez Veylume dans Applications"
          }
        }
      }
    },
    "Music and system sounds are muted during recording, then restored. Support depends on the audio output. Your own volume changes are preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Music and system sounds are muted during recording, then restored. Support depends on the audio output. Your own volume changes are preserved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Музыка и системные звуки отключаются на время записи, затем возвращаются. Поддержка зависит от аудиовыхода. Ваши изменения громкости сохраняются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La música y los sonidos del sistema se silencian durante la grabación y vuelven al terminar. Depende de la salida de audio. Se respetan tus cambios de volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La musique et les sons du système sont coupés pendant la dictée, puis rétablis. La prise en charge dépend de la sortie audio. Vos réglages de volume restent prioritaires."
          }
        }
      }
    },
