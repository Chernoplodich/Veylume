    "Models, history, recovery, statistics, dictionary, and settings will be deleted. Login launch will be disabled. macOS permissions are not reset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models, history, recovery, statistics, dictionary, and settings will be deleted. Login launch will be disabled. macOS permissions are not reset."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены модели, история, восстановления, статистика, словарь и настройки. Автозапуск будет выключен. Системные разрешения macOS не сбрасываются."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán los modelos, el historial, las recuperaciones, las estadísticas, el diccionario y la configuración. Se desactivará el inicio automático. Los permisos de macOS no se restablecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles, l’historique, les récupérations, les statistiques, le dictionnaire et les réglages seront supprimés. L’ouverture à la connexion sera désactivée. Les autorisations macOS ne seront pas réinitialisées."
          }
        }
      }
    },
    "Move Veylume to Applications": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Veylume to Applications"
          }
        },
        "ru": {
