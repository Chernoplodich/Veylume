      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New text is not being saved. Existing encrypted data remains until deletion or expiry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые тексты сейчас не сохраняются. Существующие зашифрованные данные остаются до удаления или истечения срока."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los textos nuevos no se guardan. Los datos cifrados existentes se conservan hasta que los borres o caduquen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux textes ne sont pas enregistrés. Les données chiffrées existantes restent disponibles jusqu’à leur suppression ou leur expiration."
          }
        }
      }
    },
