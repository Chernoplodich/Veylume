    "macOS has denied clipboard access. Allow it for Veylume in System Settings. Your previous clipboard is unchanged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS has denied clipboard access. Allow it for Veylume in System Settings. Your previous clipboard is unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запретила доступ к буферу. Разрешите его для Veylume в Системных настройках. Старый буфер сохранён."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloqueado el acceso al portapapeles. Permite a Veylume acceder desde Ajustes del Sistema. El contenido anterior sigue intacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué l’accès au presse-papiers. Autorisez Veylume dans Réglages Système. Le contenu précédent n’a pas été modifié."
          }
        }
      }
    },
    "macOS has denied clipboard access. Allow it to preserve the previous contents during paste.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS has denied clipboard access. Allow it to preserve the previous contents during paste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS запретила доступ к буферу. Разрешите его для сохранения прежнего содержимого при вставке."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ha bloqueado el acceso al portapapeles. Permítelo para conservar su contenido anterior al insertar texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS a bloqué l’accès au presse-papiers. Autorisez-le pour conserver son contenu précédent lors du collage."
          }
        }
      }
    },
    "macOS is not reporting a camera cutout on this display. The compact indicator will be used.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS is not reporting a camera cutout on this display. The compact indicator will be used."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS не сообщает о вырезе на этом экране. Будет показан компактный индикатор."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no detecta un recorte de cámara en esta pantalla. Se usará el indicador compacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ne signale aucune encoche sur cet écran. L’indicateur compact sera utilisé."
          }
        }
      }
    },
    "macOS will ask you to enable Veylume. Only you can grant access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask you to enable Veylume. Only you can grant access."
