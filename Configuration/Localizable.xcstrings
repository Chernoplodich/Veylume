    "Allow the microphone. It turns on only for recording.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone. It turns on only for recording."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите микрофон. Он включается только для записи."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el micrófono. Solo se activa al grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le microphone. Il ne s’active que pendant l’enregistrement."
