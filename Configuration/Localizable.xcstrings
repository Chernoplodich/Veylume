    "Hold your shortcut, then release it. Check the system microphone indicator. This test does not transcribe or insert text.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your shortcut, then release it. Check the system microphone indicator. This test does not transcribe or insert text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте назначенную клавишу, затем отпустите. Проверьте системный индикатор микрофона. Тест не распознаёт и не вставляет текст."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu atajo y suéltalo. Comprueba el indicador del micrófono de macOS. Esta prueba no transcribe ni inserta texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez votre raccourci, puis relâchez-le. Vérifiez le témoin du microphone de macOS. Ce test ne transcrit et n’insère aucun texte."
          }
        }
      }
    },
