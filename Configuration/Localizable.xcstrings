    "Audio could not be stored in time. Recording stopped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio could not be stored in time. Recording stopped."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить аудио вовремя. Запись остановлена."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el audio a tiempo. Se ha detenido la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio n’a pas pu être enregistré à temps. L’enregistrement a été arrêté."
          }
        }
      }
    },
    "Auto-paste needs Accessibility access.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-paste needs Accessibility access."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для автовставки нужен доступ Accessibility."
          }
