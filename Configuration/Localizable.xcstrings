    "Drag the app to Applications or ~/Applications, then open that copy. Set up permissions and login launch after moving it. The app does not ask for an administrator password.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the app to Applications or ~/Applications, then open that copy. Set up permissions and login launch after moving it. The app does not ask for an administrator password."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите приложение в Applications или ~/Applications, затем откройте установленную копию. Разрешения и автозапуск настраиваются после переноса. Приложение не запрашивает пароль администратора."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra Veylume a Aplicaciones o a ~/Applications y abre esa copia. Después configura los permisos y el inicio automático. La aplicación no solicita una contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez Veylume dans Applications ou ~/Applications, puis ouvrez cette copie. Configurez ensuite les autorisations et l’ouverture à la connexion. L’application ne demande pas de mot de passe administrateur."
          }
        }
      }
    },
    "Edit": {
      "localizations": {
