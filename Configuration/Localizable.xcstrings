    "An app has not finished providing the clipboard data. You can copy this result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app has not finished providing the clipboard data. You can copy this result."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение ещё не подготовило данные в буфере. Этот текст можно скопировать."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una aplicación aún no ha preparado los datos del portapapeles. Puedes copiar este resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une application n’a pas encore fourni les données du presse-papiers. Vous pouvez copier ce résultat."
          }
        }
      }
    },
    "An audio output could not be muted. You can still record; turn its volume down manually.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An audio output could not be muted. You can still record; turn its volume down manually."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить звук на одном из аудиовыходов. Запись доступна; уменьшите громкость вручную."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo silenciar una salida de audio. Puedes seguir grabando; baja su volumen manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sortie audio ne peut pas être coupée. La dictée reste disponible ; baissez son volume manuellement."
          }
        }
      }
    },
