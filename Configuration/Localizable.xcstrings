    "Report preview. No text, audio, clipboard, keystrokes, paths, or other apps’ documents are included. Reports are never sent automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report preview. No text, audio, clipboard, keystrokes, paths, or other apps’ documents are included. Reports are never sent automatically."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр отчёта. Тексты, аудио, буфер, нажатия, пути и документы других приложений не включены. Отчёт никуда не отправляется автоматически."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del informe. No incluye textos, audio, portapapeles, pulsaciones, rutas ni documentos de otras aplicaciones. Nunca se envía automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du rapport. Il ne contient ni texte, ni audio, ni presse-papiers, ni frappes, ni chemins, ni documents d’autres applications. Il n’est jamais envoyé automatiquement."
          }
        }
      }
    },
