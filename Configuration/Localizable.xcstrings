    "Veylume recognizes speech on your computer and never sends audio or text to the cloud.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Veylume recognizes speech on your computer and never sends audio or text to the cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Veylume распознаёт речь на компьютере и не отправляет аудио или текст в облако."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veylume reconoce la voz en tu Mac. No envía audio ni texto a la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veylume reconnaît la parole sur votre Mac. Aucun audio ni texte n’est envoyé dans le cloud."
          }
        }
      }
    },
    "Vocabulary hints are not enabled in these bundles yet. Replacements run after transcription in a single pass.": {
      "localizations": {
